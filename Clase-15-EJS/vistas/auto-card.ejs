<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Auto en una card</title>
    <!-- desde la raiz del servidor, /public/etc-->
    <link rel="stylesheet" href="/public/styles.css" />
  </head>
  <body>
    <h1>Auto card ejs</h1>

    <!-- Lo que esté dentro de  <% %> ejecuta JS -->
    <% if(false) { %>
    <p>no se muestra NUNCA NI EL CLIENTE SE ENTERA JAMÁS!!!</p>
    <% } else { %>
    <p>else case</p>
    <% } %>
    <!-- ejemplo foreach-->
    <%[1, 2, 3].forEach((numero) => {%>
    <p><%= numero %></p>
    <%});%>

    <!-- ejemplo auto-->
    <div class="card">
      <h2><%= auto.marca %></h2>
      <p><%= auto.modelo %></p>

      <img
        width="190"
        height="100"
        src="<%= `/imagenes/autos/${auto.imagen}`%>"
      />
      <hr />
      <p>$ <%= auto.precio %></p>
    </div>
  </body>
</html>
